    {
      "id": "emergent_compute_black_market",
      "description": "With the Taiwan blockade cutting off advanced semiconductor supplies, a clandestine market in high-performance AI chips emerges across Eastern Europe and the Mediterranean, supplied through third-party intermediaries and repurposed gaming hardware. Smuggling networks bypass export controls, and distributed compute pools begin forming outside regulatory oversight, enabling unmonitored deployment of high-capability models.",
      "first_turn": 12,
      "last_turn": 13
    }
