  "emerging_events": [
    {
      "id": "emergent_lab_cooperation",
      "description": "A loose consortium of non-US AI research labs, including several based in EU member states, begins sharing evaluation frameworks and limited model access under a mutual trust agreement. This informal coordination emerges in response to the US retrenchment posture and the lack of access to frontier evaluations, allowing the group to collectively monitor capability trends and safety risks outside American oversight. The arrangement is fragile but marks the first tangible step toward an alternative evaluation ecosystem.",
      "first_turn": 12,
      "last_turn": 13
    },
    {
      "id": "emergent_global_scientist_outreach",
      "description": "In response to the erosion of safety norms and the proliferation of open-weight agentic models, a group of senior AI researchers from non-US labs launches a global petition calling for a moratorium on autonomous agent deployment in high-risk domains. The effort gains traction among mid-career scientists and junior researchers disillusioned with current trajectories, marking the first visible fracture within the technical community along ethical lines rather than geopolitical ones.",
      "first_turn": 13,
      "last_turn": 13
    }
  ],
