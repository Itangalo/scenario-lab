OPENROUTER_API_KEY=your-key-here
# ANTHROPIC_API_KEY=your-key-here
# OPENAI_API_KEY=your-key-here
# OPENAI_BASE_URL=https://api.openai.com/v1
# For local Ollama: OPENAI_BASE_URL=http://localhost:11434/v1 and any non-empty OPENAI_API_KEY.
# For OpenCode routing (opencode:<providerID>/<modelID>) no key is needed here;
# authenticate via `opencode auth login` instead. Optional: OPENCODE_SERVER_URL=http://127.0.0.1:4096
